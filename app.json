{
  "expo": {
    "name": "Screentime",
    "slug": "screentime-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.zayan.screentime",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.8.10"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "10fafd13-96b2-4498-b32f-d2c1b6cb8fc4"
      }
    }
  }
}
